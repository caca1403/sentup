<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">

            <!-- The whole mark, for the closing pulse. Pivot is the icon centre. -->
            <group
                android:name="pulse_group"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="1"
                android:scaleY="1">

                <!-- ============ TUBE BODY ============ -->
                <!-- Drops in with a half-turn of rotation. -->
                <group
                    android:name="body_group"
                    android:pivotX="56"
                    android:pivotY="58"
                    android:scaleX="0"
                    android:scaleY="0"
                    android:rotation="-30">

                    <path
                        android:fillColor="#DAD8CD"
                        android:pathData="M56,30A12,12 0 0 1 68,42V74A12,12 0 0 1 56,86A12,12 0 0 1 44,74V42A12,12 0 0 1 56,30Z" />
                </group>

                <!-- ============ LID ============ -->
                <!-- Screws down onto the tube from above. -->
                <group
                    android:name="cap_group"
                    android:pivotX="56"
                    android:pivotY="29"
                    android:scaleX="0"
                    android:scaleY="0"
                    android:translateY="-60">

                    <path
                        android:fillColor="#DAD8CC"
                        android:pathData="M45,24H67A5,5 0 0 1 72,29A5,5 0 0 1 67,34H45A5,5 0 0 1 40,29A5,5 0 0 1 45,24Z" />
                </group>

                <!-- ============ PLAY TRIANGLE ============ -->
                <!-- Swings into place from the left. -->
                <group
                    android:name="play_group"
                    android:pivotX="49"
                    android:pivotY="58"
                    android:scaleX="0"
                    android:scaleY="0"
                    android:rotation="-90">

                    <path
                        android:fillColor="#372DA9"
                        android:pathData="M49,48L49,68L63,58Z" />
                </group>

            </group>
        </vector>
    </aapt:attr>

    <!-- ========== TUBE BODY: scale in with overshoot (0-300ms) ========== -->
    <target android:name="body_group">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:duration="300"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:duration="300"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="rotation"
                    android:valueFrom="-30"
                    android:valueTo="0"
                    android:duration="300"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>

    <!-- ========== LID: screws down from above (100-400ms) ========== -->
    <target android:name="cap_group">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:startOffset="100"
                    android:duration="300"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:startOffset="100"
                    android:duration="300"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueFrom="-60"
                    android:valueTo="0"
                    android:startOffset="100"
                    android:duration="300"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>

    <!-- ========== PLAY TRIANGLE: swings in from -90 deg (200-500ms) ========== -->
    <target android:name="play_group">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:startOffset="200"
                    android:duration="300"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:startOffset="200"
                    android:duration="300"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="rotation"
                    android:valueFrom="-90"
                    android:valueTo="0"
                    android:startOffset="200"
                    android:duration="300"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>

    <!-- ========== FINAL PULSE: the whole mark breathes (500-760ms) ========== -->
    <target android:name="pulse_group">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="1"
                    android:valueTo="1.08"
                    android:startOffset="500"
                    android:duration="120"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="1"
                    android:valueTo="1.08"
                    android:startOffset="500"
                    android:duration="120"
                    android:interpolator="@android:interpolator/accelerate_decelerate" />
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="1.08"
                    android:valueTo="1"
                    android:startOffset="620"
                    android:duration="140"
                    android:interpolator="@android:interpolator/decelerate_cubic" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="1.08"
                    android:valueTo="1"
                    android:startOffset="620"
                    android:duration="140"
                    android:interpolator="@android:interpolator/decelerate_cubic" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
