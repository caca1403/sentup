<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">

            <!-- Active Sentüp mark: squircle tile + 5 rounded equalizer bars. -->
            <group
                android:name="pulse_group"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.85"
                android:scaleY="0.85">

                <path
                    android:fillColor="#051A08"
                    android:pathData="M34,20 H74 A14,14 0 0 1 88,34 V74 A14,14 0 0 1 74,88 H34 A14,14 0 0 1 20,74 V34 A14,14 0 0 1 34,20 Z" />

                <group
                    android:name="bars_outer"
                    android:pivotX="54"
                    android:pivotY="54"
                    android:scaleY="0.4">
                    <path
                        android:fillColor="#00000000"
                        android:strokeColor="#E8F5E9"
                        android:strokeWidth="6"
                        android:strokeLineCap="round"
                        android:pathData="M30,45 V63 M78,45 V63" />
                </group>

                <group
                    android:name="bars_mid"
                    android:pivotX="54"
                    android:pivotY="54"
                    android:scaleY="0.4">
                    <path
                        android:fillColor="#00000000"
                        android:strokeColor="#E8F5E9"
                        android:strokeWidth="6"
                        android:strokeLineCap="round"
                        android:pathData="M42,39 V69 M66,39 V69" />
                </group>

                <group
                    android:name="bar_center"
                    android:pivotX="54"
                    android:pivotY="54"
                    android:scaleY="0.4">
                    <path
                        android:fillColor="#00000000"
                        android:strokeColor="#E8F5E9"
                        android:strokeWidth="6"
                        android:strokeLineCap="round"
                        android:pathData="M54,33 V75" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <target android:name="pulse_group">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.85"
                    android:valueTo="1"
                    android:duration="380"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.85"
                    android:valueTo="1"
                    android:duration="380"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="bars_outer">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="scaleY"
                android:valueFrom="0.4"
                android:valueTo="1"
                android:startOffset="100"
                android:duration="350"
                android:interpolator="@android:interpolator/overshoot" />
        </aapt:attr>
    </target>

    <target android:name="bars_mid">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="scaleY"
                android:valueFrom="0.4"
                android:valueTo="1"
                android:startOffset="160"
                android:duration="350"
                android:interpolator="@android:interpolator/overshoot" />
        </aapt:attr>
    </target>

    <target android:name="bar_center">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="scaleY"
                android:valueFrom="0.4"
                android:valueTo="1"
                android:startOffset="220"
                android:duration="350"
                android:interpolator="@android:interpolator/overshoot" />
        </aapt:attr>
    </target>
</animated-vector>
